---
import ThemeToggle from '../components/ThemeToggle.astro'
import { getUrl } from '../lib/url'

export interface Props {
  title: string
}

const { title } = Astro.props
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={getUrl('/favicon.png')} />
    <title>{title}</title>
    <script is:inline>
      (function(){var k='theme',d=document.documentElement,s=localStorage.getItem(k),t=s||(window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');d.setAttribute('data-theme',t);d.style.fontSize='120%'})()
    </script>
    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <a href={getUrl('/')}>dompub</a>
        <ThemeToggle />
      </header>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
